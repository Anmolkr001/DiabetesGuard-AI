# ============================================================
# DiabetesGuard AI — .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
*.env
.env.local
.env.production

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Node / React ---
node_modules/
frontend/build/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Datasets (raw data — do not commit) ---
machine_learning/datasets/raw/*.csv
machine_learning/datasets/raw/*.xlsx
machine_learning/datasets/raw/*.json

# --- Saved Models ---
backend/saved_models/**/*.pkl
backend/saved_models/**/*.joblib

# --- Reports / Generated Outputs ---
reports/**/*.png
reports/**/*.pdf
machine_learning/notebooks/**/*.png

# --- Database ---
backend/diabetesguard.db
*.db
*.sqlite3

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- VS Code ---
.vscode/settings.json
.vscode/launch.json

# --- MySQL dumps ---
*.sql.gz
database/backups/


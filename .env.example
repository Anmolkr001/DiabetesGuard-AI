# ============================================================
# DiabetesGuard AI & DiaCare AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM & AI Provider Configuration (DiaCare AI) ---
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# --- Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=diabetesguard_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- Security ---
SECRET_KEY=your-very-long-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
REACT_APP_API_BASE_URL=http://localhost:8000

# --- Model & Storage Paths ---
MODELS_DIR=backend/saved_models
DIACARE_UPLOAD_DIR=backend/app/diacare/uploads
DIACARE_VECTOR_DIR=backend/app/diacare/vector_store

# --- Reproducibility ---
RANDOM_SEED=42
